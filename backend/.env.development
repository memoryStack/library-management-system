# Local development. Safe to commit: uses localhost and a dev-only DB name.
# Run Postgres locally (or adjust DATABASE_URL), then: go run . -env=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# Listen address (optional). If unset, the server uses :3000 in development.
# SERVER_ADDR=:3000

# The URL of our Auth0 Tenant Domain.
# If you're using a Custom Domain, be sure to set this to that value instead.
AUTH0_DOMAIN=dev-ws7ttfcghfy4ccnb.au.auth0.com

# Our Auth0 application's Client ID.
AUTH0_CLIENT_ID=EYKATJCJOIlHK71eUl22vdelkrIPHsbF

# Our Auth0 application's Client Secret.
AUTH0_CLIENT_SECRET=kzPL12RgsT2pIo7dLqh63rV2LKQi_FvWN3ovGnDBHk6NVSuSYqTsLX1khFxaCwGr

# OAuth callback must hit THIS backend (code exchange + cookies). Must match Auth0 "Allowed Callback URLs" exactly.
AUTH0_CALLBACK_URL=http://localhost:3000/api/auth/callback

# Auth0 API identifier — MUST exist under Dashboard → Applications → APIs as an API with this exact Identifier.
# If it does not exist you get: access_denied / "Service not found: https://library-api" on /authorize.
# Also authorize this Regular Web Application for that API (Application → APIs tab).
# AUTH0_AUDIENCE=https://library-api
AUTH0_AUDIENCE=https://dev-ws7ttfcghfy4ccnb.au.auth0.com/api/v2/

# Browser origins allowed to call this API with credentials (comma-separated). Match your SPA origin.
AUTH0_CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# Where Auth0 redirects the browser after successful login (usually your SPA).
AUTH0_POST_LOGIN_REDIRECT=http://localhost:5174/

# Return URL allowed by Auth0 for /v2/logout (must be whitelisted in Auth0 Application settings).
AUTH0_LOGOUT_RETURN_URL=http://localhost:5174/

# Optional: Auth0 connection name for passwordless email (e.g. email).
# AUTH0_CONNECTION=email

# Local HTTP: Secure cookies must be false. Use true behind HTTPS in staging/prod.
AUTH0_COOKIE_SECURE=false
