# Copy to .env.development and adjust values.
SERVER_ADDR=:3000

# Postgres: either full URL or discrete fields (discrete used when DATABASE_URL is empty).
# DATABASE_URL=postgres://user:pass@localhost:5432/library_dev?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=library_dev
DB_SSLMODE=disable

# Optional pool tuning
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME_MINUTES=30

# HTTP handler timeout (seconds)
# HTTP_HANDLER_TIMEOUT_SECONDS=30

# CORS: comma-separated origins; omit or * for dev-wide open (no credentials with *)
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: load .env files from a fixed directory instead of cwd
# BACKEND_ROOT=/absolute/path/to/backend
