# Copy to .env.production (gitignored). Do not commit secrets.
DATABASE_URL=postgres://user:pass@db-host:5432/library_prod?sslmode=require

# Required in production: browser origins allowed to call this API (comma-separated).
CORS_ALLOW_ORIGINS=https://app.example.com

# Optional; defaults to :8080 when unset.
# SERVER_ADDR=:8080
