# Copy to .env.production and adjust values. Do not commit real secrets.
SERVER_ADDR=:8080

# Prefer DATABASE_URL from your secret store in real deployments.
DATABASE_URL=postgres://user:pass@db-host:5432/library_prod?sslmode=require

# If not using DATABASE_URL:
# DB_HOST=db-host
# DB_PORT=5432
# DB_USER=app
# DB_PASSWORD=change-me
# DB_NAME=library_prod
# DB_SSLMODE=require

DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30

HTTP_HANDLER_TIMEOUT_SECONDS=25

# Set explicit origins in production (required if you use cookies / credentials).
CORS_ALLOW_ORIGINS=https://app.example.com
