# Production template — replace placeholders before deploying; never commit real secrets
# to a public repo. Required vars: DATABASE_URL, CORS_ALLOW_ORIGINS.

DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/library_prod?sslmode=require

# Browser origins allowed to call this API (comma-separated). Required when -env=production.
CORS_ALLOW_ORIGINS=https://app.example.com

# Listen address (optional). If unset, the server uses :8080 in production.
# SERVER_ADDR=:8080

# --- Auth0 (required for auth routes) ---
AUTH0_DOMAIN=REPLACE_TENANT.au.auth0.com
AUTH0_CLIENT_ID=REPLACE_CLIENT_ID
AUTH0_CLIENT_SECRET=REPLACE_CLIENT_SECRET
AUTH0_CALLBACK_URL=https://api.example.com/api/auth/callback
AUTH0_AUDIENCE=https://library-api
AUTH0_POST_LOGIN_REDIRECT=https://app.example.com/
AUTH0_LOGOUT_RETURN_URL=https://app.example.com/
AUTH0_COOKIE_SECURE=true
AUTH0_CORS_ORIGINS=https://app.example.com
